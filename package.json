{
  "name": "invox-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-static.mjs",
    "predeploy": "npm run typecheck && npm run build && npm run verify",
    "deploy": "gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "gh-pages": "6.3.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
